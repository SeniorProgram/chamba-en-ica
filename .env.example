# Copia este archivo como .env.local y pon tu código cuando AdSense te apruebe
NEXT_PUBLIC_ADSENSE_CLIENT=

# Verificador de avisos con IA (/verificar/). Clave de https://console.anthropic.com — es secreta:
# ponla solo en Vercel (Settings → Environment Variables) o en .env.local, nunca en el código.
# Sin clave, el verificador funciona igual con la revisión básica (sin IA).
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude a usar (por defecto claude-opus-5-5; claude-haiku-5-5 es mucho más económico)
CLAUDE_MODEL=

# Clave pública de Web3Forms para el formulario "Publica tu oferta" (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Alertas de empleo por correo (/alertas/). Sin estas claves la página dice "muy pronto".
# Base de datos: Vercel → Storage → Upstash for Redis (crea KV_REST_API_URL y KV_REST_API_TOKEN solas)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Correos: clave de API de https://app.brevo.com (SMTP & API → API Keys) y el correo remitente verificado en Brevo
BREVO_API_KEY=
ALERTAS_REMITENTE=
# Opcional: nombre que verá la persona (por defecto "Chamba en Ica") y tope de correos al día (por defecto 280)
ALERTAS_NOMBRE=
ALERTAS_MAXIMO=
# Clave larga inventada por ti: Vercel la usa para lanzar el envío diario y nadie más pueda hacerlo
CRON_SECRET=
